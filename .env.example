# Copy to .env.local for local use; enter these in your host's secret settings.
# Never commit real tokens or include .env.local in a ZIP.
OPENAI_API_KEY=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Infinotech <website@infinotech.com>
CONTACT_TO_EMAIL=info@infinotech.com
GOOGLE_SITE_VERIFICATION=

# Required shared abuse controls (Upstash Redis REST database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Production: ask host which single-IP header it overwrites on EVERY request.
# Do not choose a client-controlled header or a comma-separated forwarding chain.
TRUSTED_IP_HEADER=
# All replicas must share the same Redis database and RATE_LIMIT_SECRET.
AI_DAILY_REQUEST_LIMIT=100
CONTACT_DAILY_REQUEST_LIMIT=100
# Exact extra HTTPS origins for preview domains, comma-separated; no wildcard.
# Use npm run dev for local browsing; production extra origins require HTTPS.
ADDITIONAL_ALLOWED_ORIGINS=
# Enable only once HTTPS works on the production domain, or set HSTS at the host.
ENABLE_HSTS=false
